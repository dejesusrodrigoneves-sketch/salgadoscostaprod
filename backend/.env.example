# === Backend Environment Variables ===

# Server
PORT=3000

# JWT
JWT_SECRET=your-jwt-secret

# Evolution API (WhatsApp)
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# Mapbox / Geocoding
MAPBOX_TOKEN=
GRAPHHOPPER_KEY=
GEOAPIFY_KEY=

# Database (Prisma)
DATABASE_URL=
DIRECT_URL=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Asaas Payments
ASAAS_ACCESS_TOKEN=
ASAAS_WEBHOOK_TOKEN=
ASAAS_ENV=production
ASAAS_PIX_EXPIRY_MIN=5
ASAAS_PIX_FEE_PERCENT=2

# Asaas Subconta API key — used to encrypt/decrypt per-empresa Asaas keys at rest.
# Required for multi-tenant Asaas integration (split payments / subconta management).
ASAAS_SUBCONTA_KEY=

# Cron / Feature flags
PIX_SYNC_CRON=*/2 * * * *
PEDIDO_RETENCAO_DIAS=30
PIX_ENABLED=false

# Firebase Cloud Messaging (for delivery driver push notifications)
# Option A: Individual env vars (recommended for Vercel/cloud deployment)
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# Option B: Service account JSON file (legacy/local fallback)
# Download from: https://console.firebase.google.com → Project Settings → Service accounts
# FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# VAPID key for web push notifications
# Get from: Firebase Console → Project Settings → Cloud Messaging → Web push certificates
FCM_VAPID_KEY=
